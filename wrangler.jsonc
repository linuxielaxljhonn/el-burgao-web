// Despliegue en Cloudflare (Workers con archivos estáticos).
// Cloudflare ejecuta "npm run build" y luego "npx wrangler deploy",
// que publica la carpeta dist/ generada por Astro.
{
  "name": "el-burgao",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}

// Despliegue en Cloudflare Workers.
// Cloudflare ejecuta "npm run build" y luego "npx wrangler deploy":
//  - dist/ (generada por Astro) se publica como archivos estáticos;
//  - worker/index.js atiende solo /api/* (acceso de socios y descuentos).
{
  "name": "el-burgao",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}

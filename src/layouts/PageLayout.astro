---
import siteConfig from '../config/site.ts';
/**
 * PageLayout.astro
 * ─────────────────────────────────────────────────────────────
 * Layout para páginas internas (no-homepage).
 * Incluye: breadcrumbs, hero de página, contenido con sidebar opcional.
 *
 * Props:
 *   title       — Título SEO (se añade "— El Burgao")
 *   description — Meta description
 *   heading     — H1 visible (puede ser distinto del title SEO)
 *   subheading  — Párrafo bajo el H1
 *   emoji       — Emoji decorativo del hero
 *   breadcrumbs — Array de { label, href? }
 *   image       — OG image opcional
 */

import BaseLayout from './BaseLayout.astro';

export interface Props {
  title:        string;
  description?: string;
  heading?:     string;
  subheading?:  string;
  emoji?:       string;
  breadcrumbs?: { label: string; href?: string }[];
  image?:       string;
  eyebrow?:     string;
  noindex?:     boolean;
}

const {
  title,
  description,
  heading     = title,
  subheading,
  emoji,
  breadcrumbs = [],
  image,
  eyebrow,
  noindex = false,
} = Astro.props;

// Schema para breadcrumbs (SEO)
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteConfig.url
    },
    ...breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": b.label,
      ...(b.href ? { "item": `${siteConfig.url}${b.href}` } : {})
    }))
  ]
} : null;
---

<BaseLayout title={title} description={description} image={image} noindex={noindex}>

  {breadcrumbSchema && (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <!-- ── HERO DE PÁGINA ── -->
  <div class="page-hero">
    <div class="page-hero__bg" aria-hidden="true"></div>
    <div class="container page-hero__content">

      <!-- Breadcrumbs -->
      {breadcrumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <ol class="breadcrumbs__list">
            <li class="breadcrumbs__item">
              <a href="/" class="breadcrumbs__link">Inicio</a>
            </li>
            {breadcrumbs.map((b, i) => (
              <li class="breadcrumbs__item">
                <span class="breadcrumbs__sep" aria-hidden="true">/</span>
                {b.href && i < breadcrumbs.length - 1 ? (
                  <a href={b.href} class="breadcrumbs__link">{b.label}</a>
                ) : (
                  <span class="breadcrumbs__current" aria-current="page">{b.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- Encabezado -->
      <div class="page-hero__text">
        {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
        {emoji && <div class="page-hero__emoji" aria-hidden="true">{emoji}</div>}
        <h1 class="page-hero__title">{heading}</h1>
        {subheading && <p class="page-hero__sub">{subheading}</p>}
      </div>

    </div>
  </div>

  <!-- ── CONTENIDO ── -->
  <div class="page-body">
    <slot />
  </div>

</BaseLayout>

<style>
/* ── HERO DE PÁGINA ─────────────────────────────────────────── */
.page-hero {
  position: relative;
  padding-top: calc(var(--header-h) + var(--space-12));
  padding-bottom: var(--space-16);
  background: var(--primitive-ocean-900);
  overflow: hidden;
}

.page-hero__bg {
  position: absolute;
  inset: 0;
  background: var(--gradient-hero);
  opacity: 0.85;
}

/* Textura de puntos suave */
.page-hero__bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(201,169,110,0.08) 1px, transparent 1px);
  background-size: 32px 32px;
}

.page-hero__content {
  position: relative;
  z-index: 1;
}

/* ── BREADCRUMBS ────────────────────────────────────────────── */
.breadcrumbs {
  margin-bottom: var(--space-8);
}

.breadcrumbs__list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-1);
  list-style: none;
}

.breadcrumbs__item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.breadcrumbs__link {
  font-size: var(--text-xs);
  font-weight: var(--weight-medium);
  letter-spacing: var(--tracking-wide);
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  transition: color var(--duration-fast);
}
.breadcrumbs__link:hover { color: var(--color-accent); }

.breadcrumbs__sep {
  font-size: var(--text-xs);
  color: rgba(255,255,255,0.25);
}

.breadcrumbs__current {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: var(--color-accent);
  letter-spacing: var(--tracking-wide);
}

/* ── TEXTO ──────────────────────────────────────────────────── */
.page-hero__text {
  max-width: var(--container-lg);
}

.page-hero__emoji {
  font-size: 3.5rem;
  margin-bottom: var(--space-4);
  filter: drop-shadow(0 4px 16px rgba(0,0,0,0.3));
  line-height: 1;
}

.page-hero__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
  font-weight: var(--weight-black);
  line-height: var(--leading-tight);
  letter-spacing: var(--tracking-snug);
  color: white;
  margin-bottom: var(--space-4);
}

.page-hero__sub {
  font-size: clamp(var(--text-base), 2vw, var(--text-xl));
  color: rgba(255,255,255,0.7);
  line-height: var(--leading-relaxed);
  max-width: 60ch;
}

/* ── BODY ───────────────────────────────────────────────────── */
.page-body {
  background: var(--color-bg);
}

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 768px) {
  .page-hero {
    padding-top: calc(var(--header-h-mobile) + var(--space-10));
    padding-bottom: var(--space-10);
  }
  .page-hero__emoji { font-size: 2.5rem; }
}
</style>

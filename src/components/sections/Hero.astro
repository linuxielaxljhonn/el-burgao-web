---
/**
 * Hero.astro
 * ─────────────────────────────────────────────────────────────
 * Hero principal de El Burgao.
 * Diseño inmersivo con:
 * - Gradiente oceánico animado (sin imagen, funciona sin fotos)
 * - Canvas de partículas flotantes (estrellas/arena)
 * - Título con em en dorado (identidad visual)
 * - CTA principal + ghost
 * - Estadísticas con contador animado
 * - Scroll indicator
 * - Glassmorphism en la tarjeta de stats
 */

import siteConfig from '../../config/site.ts';
const { stats, navCta } = siteConfig;
---

<section class="hero" id="inicio" aria-label="Inicio — El Burgao">

  <!-- ── FONDO ── -->
  <div class="hero-bg" aria-hidden="true">
    <!-- Gradiente base animado -->
    <div class="hero-gradient"></div>
    <!-- Ondas SVG decorativas -->
    <div class="hero-waves">
      <svg class="hero-wave hero-wave--1" viewBox="0 0 1440 320" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,160 C360,260 1080,60 1440,160 L1440,320 L0,320 Z" fill="rgba(201,169,110,0.04)"/>
      </svg>
      <svg class="hero-wave hero-wave--2" viewBox="0 0 1440 320" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,200 C480,80 960,280 1440,200 L1440,320 L0,320 Z" fill="rgba(27,79,114,0.12)"/>
      </svg>
    </div>
    <!-- Canvas partículas -->
    <canvas id="hero-canvas" aria-hidden="true"></canvas>
  </div>

  <!-- ── CONTENIDO ── -->
  <div class="hero-content container">

    <!-- Eyebrow -->
    <div class="hero-eyebrow" data-reveal="fade">
      <span aria-hidden="true">🚐</span>
      Autocaravanistas de Canarias · Desde {siteConfig.foundedYear}
    </div>

    <!-- Título principal -->
    <h1 class="hero-title" data-reveal="up" data-delay="100">
      La carretera<br>
      nos <em>une</em>
    </h1>

    <!-- Subtítulo -->
    <p class="hero-subtitle" data-reveal="up" data-delay="200">
      Familias autocaravanistas de todas las islas, unidas para viajar,
      compartir rutas y defender el autocaravanismo en Canarias.
    </p>

    <!-- CTAs -->
    <div class="hero-actions" data-reveal="up" data-delay="300">
      <a href="/hazte-socio" class="btn btn--primary btn--lg">
        <span>Hazte socio</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="#eventos" class="btn btn--ghost btn--lg">
        Ver próximos eventos
      </a>
    </div>

    <!-- Estadísticas -->
    <div class="hero-stats" data-reveal="up" data-delay="400" role="list" aria-label="Estadísticas de la asociación">
      <div class="hero-stat" role="listitem">
        <span class="hero-stat__number" data-counter={stats.socios} aria-label={`${stats.socios} socios`}>0</span>
        <span class="hero-stat__label">Socios (aprox.)</span>
      </div>
      <div class="hero-stat hero-stat--divider" role="listitem">
        <span class="hero-stat__number" data-counter={stats.años} aria-label={`${stats.años} años`}>0</span>
        <span class="hero-stat__label">Años de historia</span>
      </div>
      <div class="hero-stat" role="listitem">
        <span class="hero-stat__number" aria-label={`${stats.islas} islas`}>{stats.islas}</span>
        <span class="hero-stat__label">Islas para descubrir</span>
      </div>
    </div>

  </div>

  <!-- ── SCROLL INDICATOR ── -->
  <div class="hero-scroll" aria-hidden="true">
    <div class="hero-scroll__line"></div>
    <span class="hero-scroll__text">Scroll</span>
  </div>

  <!-- ── WAVE BOTTOM ── -->
  <div class="hero-bottom-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="var(--color-bg)"/>
    </svg>
  </div>

</section>

<style>
/* ── HERO BASE ──────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--primitive-ocean-950);
}

/* ── FONDO ─────────────────────────────────────────────────── */
.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: var(--gradient-hero);
  background-size: 300% 300%;
  animation: heroGradient 12s ease infinite;
}

@keyframes heroGradient {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* Ondas decorativas */
.hero-waves {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-wave {
  position: absolute;
  width: 100%;
  height: auto;
}
.hero-wave--1 {
  bottom: 20%;
  animation: waveFloat 8s ease-in-out infinite;
}
.hero-wave--2 {
  bottom: 10%;
  animation: waveFloat 10s ease-in-out infinite reverse;
}

@keyframes waveFloat {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-12px); }
}

/* Canvas partículas */
#hero-canvas {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  opacity: 0.4;
}

/* ── CONTENIDO ──────────────────────────────────────────────── */
.hero-content {
  position: relative;
  z-index: 2;
  padding-top: calc(var(--header-h) + var(--space-12));
  padding-bottom: var(--space-24);
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  max-width: 760px;
}

/* Eyebrow */
.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-widest);
  text-transform: uppercase;
  color: var(--color-accent);
  padding: var(--space-2) var(--space-4);
  background: rgba(201, 169, 110, 0.12);
  border: 1px solid rgba(201, 169, 110, 0.25);
  border-radius: var(--radius-full);
  width: fit-content;
  backdrop-filter: blur(4px);
}

/* Título */
.hero-title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-5xl), 9vw, var(--text-8xl));
  font-weight: var(--weight-black);
  line-height: var(--leading-tight);
  letter-spacing: var(--tracking-snug);
  color: var(--color-text-inverse);
}

.hero-title em {
  font-style: italic;
  color: var(--color-accent);
  /* Subrayado decorativo dorado */
  text-decoration: underline;
  text-decoration-color: rgba(201, 169, 110, 0.35);
  text-underline-offset: 8px;
  text-decoration-thickness: 3px;
}

/* Subtítulo */
.hero-subtitle {
  font-size: clamp(var(--text-base), 2vw, var(--text-lg));
  color: rgba(255, 255, 255, 0.72);
  line-height: var(--leading-relaxed);
  max-width: 48ch;
}

/* CTAs */
.hero-actions {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-top: var(--space-2);
}

/* ── ESTADÍSTICAS ───────────────────────────────────────────── */
.hero-stats {
  display: flex;
  align-items: center;
  gap: var(--space-10);
  margin-top: var(--space-6);
  padding-top: var(--space-6);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.hero-stat {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  position: relative;
}

.hero-stat--divider::before {
  content: '';
  position: absolute;
  left: calc(-1 * var(--space-5));
  top: 10%;
  height: 80%;
  width: 1px;
  background: rgba(255, 255, 255, 0.12);
}

.hero-stat__number {
  font-family: var(--font-display);
  font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  line-height: 1;
}

.hero-stat__label {
  font-size: var(--text-xs);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.45);
  font-weight: var(--weight-medium);
}

/* ── SCROLL INDICATOR ───────────────────────────────────────── */
.hero-scroll {
  position: absolute;
  bottom: var(--space-12);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  z-index: 2;
  animation: scrollBounce 2.5s ease-in-out infinite;
}

.hero-scroll__line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.4));
}

.hero-scroll__text {
  font-size: var(--text-2xs);
  letter-spacing: var(--tracking-widest);
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.35);
  font-weight: var(--weight-medium);
}

@keyframes scrollBounce {
  0%, 100% { opacity: 0.4; transform: translateX(-50%) translateY(0); }
  50%       { opacity: 1;   transform: translateX(-50%) translateY(8px); }
}

/* ── WAVE BOTTOM ─────────────────────────────────────────────── */
.hero-bottom-wave {
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  z-index: 3;
  line-height: 0;
}
.hero-bottom-wave svg {
  display: block;
  width: 100%;
}

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 768px) {
  .hero-content {
    padding-top: calc(var(--header-h-mobile) + var(--space-10));
    padding-bottom: var(--space-20);
    gap: var(--space-5);
  }

  .hero-stats {
    gap: var(--space-6);
  }

  .hero-stat--divider::before {
    left: calc(-1 * var(--space-3));
  }

  .hero-scroll {
    display: none;
  }
}

@media (max-width: 480px) {
  .hero-actions {
    flex-direction: column;
    width: 100%;
  }
  .hero-actions .btn { width: 100%; justify-content: center; }
  .hero-stats { flex-wrap: wrap; gap: var(--space-5); }
  .hero-stat--divider::before { display: none; }
}

/* Modo oscuro ya está bien (fondo ocean por defecto) */
</style>

<script>
/* Partículas en canvas — adaptado de v1 */
(function () {
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let particles: Array<{
    x: number; y: number; vx: number; vy: number;
    r: number; a: number;
  }> = [];

  function resize() {
    canvas.width  = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
  }

  function init() {
    resize();
    const count = Math.floor((canvas.width * canvas.height) / 14000);
    particles = Array.from({ length: count }, () => ({
      x:  Math.random() * canvas.width,
      y:  Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * 0.25,
      vy: (Math.random() - 0.5) * 0.25,
      r:  Math.random() * 1.5 + 0.4,
      a:  Math.random() * 0.5 + 0.15,
    }));
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    particles.forEach(p => {
      // Mover
      p.x += p.vx;
      p.y += p.vy;

      // Wrap
      if (p.x < 0) p.x = canvas.width;
      if (p.x > canvas.width)  p.x = 0;
      if (p.y < 0) p.y = canvas.height;
      if (p.y > canvas.height) p.y = 0;

      // Dibujar
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(201, 169, 110, ${p.a})`;
      ctx.fill();
    });

    requestAnimationFrame(draw);
  }

  init();
  draw();

  window.addEventListener('resize', () => {
    resize();
    init();
  }, { passive: true });
})();
</script>

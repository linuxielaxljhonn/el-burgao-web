---
/**
 * SectionNoticias.astro
 * ─────────────────────────────────────────────────────────────
 * Sección de noticias: noticia destacada + grid de 3 cards.
 * Datos desde Content Collections (src/content/noticias/).
 *
 * Añadir una noticia = crear un .md. Sin tocar este componente.
 */

import { getCollection } from 'astro:content';

// Cargar y ordenar noticias (más reciente primero, excluir drafts)
// Los anuncios con fecha de caducidad pasada dejan de salir en portada
const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
const allNoticias = await getCollection('noticias', ({ data }) =>
  !data.draft && !(data.expires && data.expires < hoy));
allNoticias.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = allNoticias.find(n => n.data.featured) ?? allNoticias[0];
const rest     = allNoticias.filter(n => n.slug !== featured?.slug).slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('es-ES', {
    day: 'numeric', month: 'long', year: 'numeric'
  });
}
---

<section class="section" id="noticias" aria-labelledby="noticias-title">
  <div class="container">

    <header class="section-header" data-reveal="up">
      <p class="eyebrow">📰 Noticias</p>
      <h2 class="section-title" id="noticias-title">Últimas noticias</h2>
      <p class="section-desc">
        Todo lo que pasa en la comunidad autocaravanista de Canarias,
        al día y sin filtros.
      </p>
    </header>

    <!-- ── NOTICIA DESTACADA ── -->
    {featured && (
      <article class="news-featured card" data-reveal="up" data-delay="100">
        <div class="news-featured__img" aria-hidden="true">
          <span class="news-featured__emoji">{featured.data.emoji}</span>
          <div class="news-featured__badge">{featured.data.category}</div>
        </div>
        <div class="news-featured__body">
          <div class="news-featured__meta">
            <time datetime={featured.data.date.toISOString()}>
              {formatDate(featured.data.date)}
            </time>
            <span aria-hidden="true">·</span>
            <span>{featured.data.category}</span>
          </div>
          <h3 class="news-featured__title">{featured.data.title}</h3>
          <p class="news-featured__excerpt">{featured.data.excerpt}</p>
          <a href={`/noticias/${featured.slug}`} class="news-featured__link">
            Leer noticia completa
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </article>
    )}

    <!-- ── GRID DE NOTICIAS ── -->
    {rest.length > 0 && (
      <div class="news-grid" role="list" aria-label="Más noticias">
        {rest.map((noticia, i) => (
          <article class="news-card card card--hoverable" role="listitem"
            data-reveal="up" data-delay={`${(i + 1) * 100}`}>
            <div class="news-card__img" aria-hidden="true">
              <span class="news-card__emoji">{noticia.data.emoji}</span>
              <span class="news-card__category">{noticia.data.category}</span>
            </div>
            <div class="news-card__body">
              <time class="news-card__date" datetime={noticia.data.date.toISOString()}>
                {formatDate(noticia.data.date)}
              </time>
              <h3 class="news-card__title">{noticia.data.title}</h3>
              <p class="news-card__excerpt">{noticia.data.excerpt}</p>
              <a href={`/noticias/${noticia.slug}`} class="news-card__link">
                Leer más
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

    <!-- Footer de sección -->
    <div class="section-footer" data-reveal="up">
      <a href="/noticias" class="btn btn--outline">
        Ver todas las noticias
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
/* ── NOTICIA DESTACADA ──────────────────────────────────────── */
.news-featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 380px;
  margin-bottom: var(--space-10);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.news-featured__img {
  position: relative;
  background: var(--gradient-ocean);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 260px;
  overflow: hidden;
}

/* Textura sutil sobre el gradiente */
.news-featured__img::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 50%, rgba(201,169,110,0.12) 0%, transparent 70%);
}

.news-featured__emoji {
  font-size: 5rem;
  opacity: 0.5;
  filter: drop-shadow(0 4px 20px rgba(0,0,0,0.3));
  z-index: 1;
}

.news-featured__badge {
  position: absolute;
  top: var(--space-5);
  left: var(--space-5);
  background: var(--color-accent);
  color: var(--primitive-ocean-900);
  font-size: var(--text-2xs);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  z-index: 2;
}

.news-featured__body {
  padding: var(--space-10);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-4);
}

.news-featured__meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
  font-weight: var(--weight-medium);
}
.news-featured__meta time { color: var(--color-brand); }

.news-featured__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-xl), 2.5vw, var(--text-3xl));
  font-weight: var(--weight-bold);
  line-height: var(--leading-snug);
  letter-spacing: var(--tracking-snug);
  color: var(--color-text);
}

.news-featured__excerpt {
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  font-size: var(--text-sm);
}

.news-featured__link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-brand);
  text-decoration: none;
  transition: gap var(--duration-fast);
  margin-top: var(--space-2);
  width: fit-content;
}
.news-featured__link:hover { gap: var(--space-4); }

/* ── GRID ───────────────────────────────────────────────────── */
.news-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
}

/* ── CARD ───────────────────────────────────────────────────── */
.news-card__img {
  height: 180px;
  background: var(--gradient-sunset);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.news-card__emoji {
  font-size: 3.5rem;
  opacity: 0.5;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
}

.news-card__category {
  position: absolute;
  bottom: var(--space-3);
  left: var(--space-3);
  background: var(--color-accent);
  color: var(--primitive-ocean-900);
  font-size: var(--text-2xs);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
}

.news-card__body {
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  flex: 1;
}

.news-card__date {
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
  font-weight: var(--weight-medium);
}

.news-card__title {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  line-height: var(--leading-snug);
  color: var(--color-text);
  letter-spacing: var(--tracking-snug);
}

.news-card__excerpt {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-card__link {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-brand);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  margin-top: auto;
  transition: gap var(--duration-fast);
  width: fit-content;
}
.news-card__link:hover { gap: var(--space-3); }

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .news-featured {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .news-featured__img { min-height: 220px; }
  .news-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .news-grid { grid-template-columns: 1fr; }
  .news-featured__body { padding: var(--space-6); }
}
</style>

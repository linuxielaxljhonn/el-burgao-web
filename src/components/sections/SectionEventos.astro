---
/**
 * SectionEventos.astro
 * ─────────────────────────────────────────────────────────────
 * Sección de próximos eventos con calendario visual.
 * Datos desde Content Collections (src/content/eventos/).
 */

import { getCollection } from 'astro:content';

const allEventos = await getCollection('eventos', ({ data }) => !data.draft);

// Solo eventos futuros o hoy, ordenados por fecha
const now = new Date();
now.setHours(0, 0, 0, 0);

const eventos = allEventos
  .filter(e => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const MESES_ES = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

function getMes(date: Date) { return MESES_ES[date.getMonth()]; }
function getDia(date: Date) { return date.getDate().toString().padStart(2, '0'); }
---

<section class="section section--dark" id="eventos" aria-labelledby="eventos-title">
  <div class="container">

    <header class="section-header section-header--inverted" data-reveal="up">
      <p class="eyebrow eyebrow--light">📅 Agenda</p>
      <h2 class="section-title" id="eventos-title">Próximos eventos</h2>
      <p class="section-desc">
        Encuentros, rutas, reuniones, asambleas y convocatorias.
        Toda la actividad de El Burgao en un solo lugar.
      </p>
    </header>

    {eventos.length > 0 ? (
      <div class="eventos-list" role="list" aria-label="Lista de próximos eventos">
        {eventos.map((evento, i) => (
          <article
            class="evento-card"
            role="listitem"
            data-reveal="up"
            data-delay={`${i * 100}`}
          >
            <!-- Fecha -->
            <div class="evento-card__date" aria-label={`Fecha: ${getDia(evento.data.date)} de ${getMes(evento.data.date)}`}>
              <span class="evento-card__day">{getDia(evento.data.date)}</span>
              <span class="evento-card__month">{getMes(evento.data.date)}</span>
            </div>

            <!-- Emoji tipo -->
            <div class="evento-card__icon" aria-hidden="true">
              {evento.data.emoji}
            </div>

            <!-- Contenido -->
            <div class="evento-card__body">
              <div class="evento-card__meta">
                <span class="badge badge--dark">{evento.data.type}</span>
                {evento.data.membersOnly && (
                  <span class="badge badge--accent">Solo socios</span>
                )}
              </div>
              <h3 class="evento-card__title">{evento.data.title}</h3>
              <p class="evento-card__desc">{evento.data.description}</p>
              <div class="evento-card__location">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
                <span>{evento.data.location}</span>
              </div>
            </div>

            <!-- Acciones -->
            <div class="evento-card__actions">
              <a href={`/eventos/${evento.slug}`} class="btn btn--primary btn--sm">
                Ver detalles
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="eventos-empty" data-reveal="fade">
        <span aria-hidden="true">📅</span>
        <p>Próximamente nuevas fechas. La junta publicará aquí los próximos encuentros, reuniones y asambleas.</p>
      </div>
    )}

    <div class="section-footer" data-reveal="up">
      <a href="/eventos" class="btn btn--ghost">
        Ver calendario completo
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
/* ── LISTA DE EVENTOS ───────────────────────────────────────── */
.eventos-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-bottom: var(--space-10);
}

/* ── EVENTO CARD ─────────────────────────────────────────────── */
.evento-card {
  display: grid;
  grid-template-columns: 80px 56px 1fr auto;
  align-items: center;
  gap: var(--space-6);
  padding: var(--space-5) var(--space-6);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: var(--radius-xl);
  transition:
    background var(--duration-base),
    border-color var(--duration-base),
    transform var(--duration-base) var(--ease-out);
  backdrop-filter: blur(var(--blur-sm));
}

.evento-card:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(201, 169, 110, 0.25);
  transform: translateX(4px);
}

/* Fecha */
.evento-card__date {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-0-5);
  background: rgba(201, 169, 110, 0.1);
  border: 1px solid rgba(201, 169, 110, 0.2);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-2);
  flex-shrink: 0;
}

.evento-card__day {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  line-height: 1;
}

.evento-card__month {
  font-size: var(--text-2xs);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
}

/* Icono */
.evento-card__icon {
  font-size: 2rem;
  text-align: center;
  flex-shrink: 0;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
}

/* Body */
.evento-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  min-width: 0;
}

.evento-card__meta {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.evento-card__title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: white;
  line-height: var(--leading-snug);
  letter-spacing: var(--tracking-snug);
}

.evento-card__desc {
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.6);
  line-height: var(--leading-normal);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.evento-card__location {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.45);
  font-weight: var(--weight-medium);
}

/* Acciones */
.evento-card__actions {
  flex-shrink: 0;
}

/* Vacío */
.eventos-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-16);
  color: rgba(255, 255, 255, 0.4);
  font-size: var(--text-lg);
  text-align: center;
}
.eventos-empty span { font-size: 3rem; }

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 768px) {
  .evento-card {
    grid-template-columns: 72px 1fr;
    grid-template-rows: auto auto;
    gap: var(--space-4);
  }

  .evento-card__icon { display: none; }

  .evento-card__actions {
    grid-column: 1 / -1;
  }
}

@media (max-width: 480px) {
  .evento-card {
    padding: var(--space-4);
  }
  .evento-card__title { font-size: var(--text-lg); }
}
</style>

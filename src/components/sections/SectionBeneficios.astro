---
/**
 * SectionBeneficios.astro
 * src/components/sections/SectionBeneficios.astro
 * ─────────────────────────────────────────────────────────────
 * Sección de beneficios para ser socio — antes del CTA.
 * Diseño en grid con iconos y texto. Accesible y responsive.
 */

import siteConfig from '../../config/site.ts';
const { cuota } = siteConfig;
const { ctaHref = '/hazte-socio' } = Astro.props as { ctaHref?: string };

const beneficios = [
  { icon: '🏕️', title: 'Encuentros',          desc: 'Jornadas de convivencia y concentraciones en distintas islas a lo largo del año.' },
  { icon: '🗺️', title: 'Rutas y pernoctas',   desc: 'Rutas, paradas y lugares de pernocta recomendados y comprobados por socios.' },
  { icon: '💳', title: 'Carnet de socio',     desc: 'Descuentos en gasolineras, talleres, ITV, neumáticos y más de 40 empresas colaboradoras.' },
  { icon: '⛴️', title: 'Viajar entre islas',  desc: 'Información y ventajas para embarcar con tu vehículo entre islas.' },
  { icon: '📢', title: 'Defensa del sector',  desc: 'Representación ante administraciones y seguimiento de la normativa canaria.' },
  { icon: '📰', title: 'Avisos y normativa',  desc: 'Novedades sobre áreas de autocaravanas, ordenanzas y señalización.' },
  { icon: '🤝', title: 'Red de apoyo',        desc: 'Una comunidad de autocaravanistas dispuesta a ayudarse en ruta.' },
  { icon: '🌿', title: 'Turismo responsable', desc: 'Respeto al entorno natural y a los vecinos de las Islas Canarias.' },
];
---

<section class="section section--alt" id="beneficios" aria-labelledby="beneficios-title">
  <div class="container">

    <header class="section-header" data-reveal="up">
      <p class="eyebrow">✅ Beneficios</p>
      <h2 class="section-title" id="beneficios-title">¿Por qué ser socio de El Burgao?</h2>
      <p class="section-desc">
        <strong>{cuota.alta} € el primer año</strong> y {cuota.renovacion} € las renovaciones.
      </p>
    </header>

    <div class="beneficios-grid" role="list" aria-label="Lista de beneficios">
      {beneficios.map((b, i) => (
        <div
          class="beneficio-card"
          role="listitem"
          data-reveal="up"
          data-delay={`${(i % 4) * 100}`}
        >
          <div class="beneficio-card__icon" aria-hidden="true">{b.icon}</div>
          <h3 class="beneficio-card__title">{b.title}</h3>
          <p class="beneficio-card__desc">{b.desc}</p>
        </div>
      ))}
    </div>

    <!-- CTA final -->
    <div class="beneficios-cta" data-reveal="up">
      <div class="beneficios-cta__price">
        <span class="beneficios-cta__amount">{cuota.alta} €</span>
        <span class="beneficios-cta__period">el primer año · renovación {cuota.renovacion} €</span>
      </div>
      <a href="/ventajas" class="btn btn--ghost btn--lg">Ver empresas con descuento</a>
      <a href={ctaHref} class="btn btn--primary btn--lg">
        Quiero ser socio
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
/* ── GRID ────────────────────────────────────────────────────── */
.beneficios-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-5);
  margin-bottom: var(--space-12);
}

/* ── CARD ────────────────────────────────────────────────────── */
.beneficio-card {
  background: var(--color-bg-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  transition:
    transform   var(--duration-base) var(--ease-out),
    box-shadow  var(--duration-base),
    border-color var(--duration-base);
  box-shadow: var(--shadow-sm);
}

.beneficio-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--color-border-strong);
}

.beneficio-card__icon {
  font-size: 2rem;
  line-height: 1;
}

.beneficio-card__title {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-text);
  line-height: var(--leading-snug);
}

.beneficio-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  max-width: none;
}

/* ── CTA ─────────────────────────────────────────────────────── */
.beneficios-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-8);
  flex-wrap: wrap;
  padding: var(--space-8) var(--space-10);
  background: var(--gradient-ocean);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-brand);
}

.beneficios-cta__price {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
}

.beneficios-cta__amount {
  font-family: var(--font-display);
  font-size: var(--text-5xl);
  font-weight: var(--weight-black);
  color: var(--color-accent);
  line-height: 1;
}

.beneficios-cta__period {
  font-size: var(--text-base);
  color: rgba(255, 255, 255, 0.65);
  max-width: 16ch;
  line-height: var(--leading-snug);
}

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .beneficios-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .beneficios-grid { grid-template-columns: 1fr; }
  .beneficios-cta  { flex-direction: column; text-align: center; padding: var(--space-6); }
}
</style>

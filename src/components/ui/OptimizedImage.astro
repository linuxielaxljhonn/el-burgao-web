---
/**
 * OptimizedImage.astro
 * src/components/ui/OptimizedImage.astro
 * ─────────────────────────────────────────────────────────────
 * Componente de imagen accesible y optimizado para rendimiento.
 *
 * Características:
 * - Lazy loading nativo (loading="lazy")
 * - Decoding asíncrono (decoding="async")
 * - aspect-ratio para evitar CLS (Cumulative Layout Shift)
 * - Placeholder de color mientras carga
 * - srcset para diferentes densidades de pantalla
 * - Fallback graceful si no hay imagen real
 *
 * Uso:
 *   <OptimizedImage
 *     src="/assets/img/concentracion.jpg"
 *     alt="Concentración de primavera en Maspalomas"
 *     width={800}
 *     height={450}
 *     eager={true}   ← solo para imagen hero (LCP)
 *     class="mi-clase"
 *   />
 */

export interface Props {
  src:        string;
  alt:        string;
  width?:     number;
  height?:    number;
  eager?:     boolean;    // true solo para imagen above-the-fold (LCP)
  class?:     string;
  style?:     string;
  placeholder?: string;  // color CSS de fondo mientras carga
  rounded?:   boolean;
  caption?:   string;
}

const {
  src,
  alt,
  width     = 800,
  height    = 450,
  eager     = false,
  class:    className = '',
  style     = '',
  placeholder = 'var(--primitive-ocean-900)',
  rounded   = false,
  caption,
} = Astro.props;

// Detectar si es imagen externa o local
const isExternal = src.startsWith('http://') || src.startsWith('https://');

// Calcular aspect ratio para evitar CLS
const ratio = ((height / width) * 100).toFixed(4);

// Para imágenes locales, generar srcset básico
// En producción, Astro Image optimizaría automáticamente
const hasSrc = src && src !== '' && src !== '/placeholder';
---

{caption ? (
  <figure class:list={['opt-image-wrap', { 'opt-image-wrap--rounded': rounded }]}>
    <div
      class="opt-image-container"
      style={`padding-bottom:${ratio}%;background:${placeholder};`}
      aria-hidden={!hasSrc ? 'true' : undefined}
    >
      {hasSrc ? (
        <img
          src={src}
          alt={alt}
          width={width}
          height={height}
          loading={eager ? 'eager' : 'lazy'}
          decoding={eager ? 'sync' : 'async'}
          class:list={['opt-image', className]}
          style={style}
          onload="this.classList.add('is-loaded')"
        />
      ) : (
        <div class="opt-image-placeholder" role="img" aria-label={alt}>
          <span aria-hidden="true">🏝️</span>
        </div>
      )}
    </div>
    <figcaption class="opt-image-caption">{caption}</figcaption>
  </figure>
) : (
  <div
    class:list={['opt-image-container', { 'opt-image-container--rounded': rounded }]}
    style={`padding-bottom:${ratio}%;background:${placeholder};`}
    aria-hidden={!hasSrc ? 'true' : undefined}
  >
    {hasSrc ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        class:list={['opt-image', className]}
        style={style}
        onload="this.classList.add('is-loaded')"
      />
    ) : (
      <div class="opt-image-placeholder" role="img" aria-label={alt}>
        <span aria-hidden="true">🏝️</span>
      </div>
    )}
  </div>
)}

<style>
.opt-image-container {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.opt-image-container--rounded,
.opt-image-wrap--rounded .opt-image-container {
  border-radius: var(--radius-lg);
}

.opt-image {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.opt-image.is-loaded {
  opacity: 1;
}

/* Placeholder cuando no hay imagen */
.opt-image-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
  opacity: 0.3;
  background: var(--gradient-ocean);
}

/* Figure wrapper */
.opt-image-wrap {
  margin: 0;
}
.opt-image-wrap--rounded {
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.opt-image-caption {
  margin-top: var(--space-3);
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
  text-align: center;
  font-style: italic;
  line-height: var(--leading-normal);
}
</style>

---
/**
 * Footer.astro
 * ─────────────────────────────────────────────────────────────
 * Footer completo con:
 * - Logo + descripción + redes sociales
 * - Columnas de navegación
 * - Contacto con address semántico
 * - Barra legal inferior
 * - Año dinámico (sin JS, calculado en build)
 */

import siteConfig, { isPendiente } from '../../config/site.ts';
const { name, foundedYear, contact, nav, author } = siteConfig;
const social = siteConfig.social.filter(s => s.url);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="var(--footer-bg, #0d2a3d)" />
    </svg>
  </div>

  <div class="footer-body">
    <div class="container">
      <div class="footer-grid">

        <!-- ── MARCA ── -->
        <div class="footer-brand">
          <a href="/" class="footer-logo" aria-label={`${name} — Inicio`}>
            <img
              class="footer-logo__img"
              src="/assets/img/logo/logo-completo-h200.png"
              srcset="/assets/img/logo/logo-completo-h200.png 1x, /assets/img/logo/logo-completo-h400.png 2x"
              width="146" height="120"
              style="aspect-ratio: 243/200; width: 110px; height: auto;"
              alt={`${name} — logo`}
              loading="lazy"
              decoding="async"
            />
          </a>
          <p class="footer-tagline">
            Asociación de autocaravanistas de las Islas Canarias desde {foundedYear}.
            Porque la mejor dirección es la que tú eliges.
          </p>
          {social.length > 0 && <div class="footer-social" role="list" aria-label="Redes sociales">
            {social.map(s => (
              <a
                href={s.url}
                class="footer-social__link"
                aria-label={s.name}
                rel="noopener noreferrer"
                target="_blank"
                role="listitem"
              >
                {s.icon === 'facebook' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                  </svg>
                )}
                {s.icon === 'instagram' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                )}
                {s.icon === 'whatsapp' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                  </svg>
                )}
              </a>
            ))}
          </div>}
        </div>

        <!-- ── NAVEGACIÓN ── -->
        <div class="footer-col">
          <h4 class="footer-col__heading">Explorar</h4>
          <ul class="footer-links" role="list">
            {nav.slice(1).map(item => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- ── SOCIOS / LEGAL ── -->
        <div class="footer-col">
          <h4 class="footer-col__heading">Asociación</h4>
          <ul class="footer-links" role="list">
            <li><a href="/hazte-socio">Hazte socio</a></li>
            <li><a href="/rutas">Rutas</a></li>
            <li><a href="/viajar-entre-islas">Viajar entre islas</a></li>
            <li><a href="/galeria">Galería</a></li>
            <li><a href="/aviso-legal">Aviso legal</a></li>
            <li><a href="/privacidad">Privacidad (RGPD)</a></li>
            <li><a href="/cookies">Cookies</a></li>
          </ul>
        </div>

        <!-- ── CONTACTO ── -->
        <div class="footer-col">
          <h4 class="footer-col__heading">Contacto</h4>
          <address class="footer-address">
            {isPendiente(contact.email) ? <span class="footer-address__item footer-address__item--text">{contact.email}</span> : <a href={`mailto:${contact.email}`} class="footer-address__item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              {contact.email}
            </a>}
            {contact.whatsapp && <a href={`https://wa.me/${contact.whatsapp.replace(/\D/g, '')}`} class="footer-address__item" target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
              </svg>
              WhatsApp
            </a>}
            <span class="footer-address__item footer-address__item--text">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              {contact.location}
            </span>
          </address>
        </div>

      </div><!-- /footer-grid -->

      <!-- ── BARRA LEGAL ── -->
      <div class="footer-bottom">
        <p>
          &copy; {currentYear} {name}.
          Todos los derechos reservados.
        </p>
        <p class="footer-bottom__love">
          Web desarrollada por {author}
        </p>
      </div>

    </div><!-- /container -->
  </div><!-- /footer-body -->
</footer>

<style>
  :root {
    --footer-bg: var(--primitive-ocean-900);
  }

  /* ── WAVE SEPARATOR ────────────────────────────────────────── */
  .footer-wave {
    display: block;
    line-height: 0;
    margin-top: calc(-1px);
  }
  .footer-wave svg {
    width: 100%;
    display: block;
  }

  /* ── BODY ───────────────────────────────────────────────────── */
  .footer-body {
    background: var(--footer-bg);
    color: rgba(255,255,255,0.75);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }

  /* ── GRID ───────────────────────────────────────────────────── */
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    margin-bottom: var(--space-8);
  }

  /* ── BRAND ──────────────────────────────────────────────────── */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    color: white;
    text-decoration: none;
    transition: opacity var(--duration-fast);
  }
  .footer-logo:hover { opacity: 0.8; }
  .footer-logo__img {
    height: 90px;
    width: auto;
    display: block;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.55);
    line-height: var(--leading-relaxed);
    max-width: 28ch;
  }

  /* ── SOCIAL ─────────────────────────────────────────────────── */
  .footer-social {
    display: flex;
    gap: var(--space-3);
  }

  .footer-social__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-md);
    color: rgba(255,255,255,0.65);
    transition:
      background var(--duration-fast),
      color     var(--duration-fast),
      border-color var(--duration-fast);
    text-decoration: none;
  }
  .footer-social__link:hover {
    background: var(--color-accent);
    color: var(--primitive-ocean-900);
    border-color: var(--color-accent);
  }

  /* ── COLUMNAS ───────────────────────────────────────────────── */
  .footer-col__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: white;
    margin-bottom: var(--space-5);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: color var(--duration-fast);
    display: inline-block;
  }
  .footer-links a:hover { color: var(--color-accent); }

  /* ── CONTACTO ───────────────────────────────────────────────── */
  .footer-address {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-style: normal;
  }

  .footer-address__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: color var(--duration-fast);
  }
  .footer-address__item:not(.footer-address__item--text):hover {
    color: var(--color-accent);
  }

  /* ── BOTTOM BAR ─────────────────────────────────────────────── */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.35);
    flex-wrap: wrap;
  }

  .footer-bottom__love {
    font-style: italic;
  }

  /* ── RESPONSIVE ─────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .footer-brand { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: var(--space-8); }
    .footer-tagline { max-width: 40ch; }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .footer-brand { flex-direction: column; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }
</style>

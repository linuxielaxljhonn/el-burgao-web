---
/**
 * rutas.astro
 * ─────────────────────────────────────────────────────────────
 * Página /rutas — Listado de rutas con filtro por isla.
 * Datos desde Content Collections.
 */

import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const rutas = await getCollection('rutas', ({ data }) => !data.draft);
rutas.sort((a, b) => a.data.order - b.data.order);

// Islas únicas para el filtro
const islas = [...new Set(rutas.map(r => r.data.isla))];

const islaLabels: Record<string, string> = {
  'gran-canaria':  'Gran Canaria',
  'tenerife':      'Tenerife',
  'lanzarote':     'Lanzarote',
  'fuerteventura': 'Fuerteventura',
  'la-palma':      'La Palma',
  'la-gomera':     'La Gomera',
  'el-hierro':     'El Hierro',
  'la-graciosa':   'La Graciosa',
};

const difficultyColor: Record<string, string> = {
  'Fácil':    '#27AE60',
  'Moderada': '#C9A96E',
  'Difícil':  '#e74c3c',
};
---

<PageLayout
  title="Rutas en autocaravana"
  description="Las mejores rutas en autocaravana por las Islas Canarias. Itinerarios detallados, distancias, dificultad y servicios cerca."
  heading="Rutas en autocaravana"
  subheading="Itinerarios probados por socios de El Burgao. Con distancias, duración, dificultad y todos los servicios que necesitas."
  emoji="🗺️"
  eyebrow="🗺️ Rutas"
  breadcrumbs={[{ label: 'Rutas', href: '/rutas' }]}
>

  <section class="section">
    <div class="container">

      <!-- ── FILTROS ── -->
      <div class="rutas-filters" role="group" aria-label="Filtrar rutas por isla">
        <button class="filter-btn is-active" data-filter="all">
          Todas <span class="filter-btn__count">{rutas.length}</span>
        </button>
        {islas.map(isla => {
          const count = rutas.filter(r => r.data.isla === isla).length;
          return (
            <button class="filter-btn" data-filter={isla}>
              {islaLabels[isla] ?? isla}
              <span class="filter-btn__count">{count}</span>
            </button>
          );
        })}
      </div>

      <!-- ── GRID DE RUTAS ── -->
      <div class="rutas-grid" id="rutasGrid" role="list" aria-label="Lista de rutas">
        {rutas.map((ruta, i) => (
          <article
            class="ruta-card card card--hoverable"
            role="listitem"
            data-isla={ruta.data.isla}
            data-reveal="up"
            data-delay={`${(i % 3) * 100}`}
          >
            <!-- Imagen / Color placeholder -->
            <div class="ruta-card__img">
              <span class="ruta-card__emoji" aria-hidden="true">{ruta.data.emoji}</span>

              <!-- Badges superpuestos -->
              <div class="ruta-card__badges">
                <span
                  class="ruta-card__difficulty"
                  style={`background:${difficultyColor[ruta.data.difficulty] ?? '#888'}`}
                >
                  {ruta.data.difficulty}
                </span>
                {ruta.data.featured && (
                  <span class="ruta-card__featured">⭐ Destacada</span>
                )}
              </div>
            </div>

            <!-- Cuerpo -->
            <div class="ruta-card__body">
              <div class="ruta-card__meta">
                <span class="ruta-card__isla">
                  🏝️ {islaLabels[ruta.data.isla] ?? ruta.data.isla}
                </span>
              </div>

              <h2 class="ruta-card__title">{ruta.data.title}</h2>
              <p class="ruta-card__excerpt">{ruta.data.excerpt}</p>

              <!-- Detalles rápidos -->
              <div class="ruta-card__details">
                <span class="ruta-card__detail">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {ruta.data.duration}
                </span>
                {ruta.data.distance && (
                  <span class="ruta-card__detail">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M3 12h18M3 6h18M3 18h18"/>
                    </svg>
                    {ruta.data.distance}
                  </span>
                )}
              </div>

              <!-- Highlights -->
              {ruta.data.highlights.length > 0 && (
                <ul class="ruta-card__highlights" aria-label="Puntos de interés">
                  {ruta.data.highlights.slice(0, 3).map(h => (
                    <li>{h}</li>
                  ))}
                  {ruta.data.highlights.length > 3 && (
                    <li class="ruta-card__more">+{ruta.data.highlights.length - 3} más</li>
                  )}
                </ul>
              )}

              <a href={`/rutas/${ruta.slug}`} class="btn btn--secondary btn--sm ruta-card__cta">
                Ver ruta completa
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Estado vacío (JS lo muestra si no hay resultados) -->
      <div class="rutas-empty" id="rutasEmpty" hidden>
        <span aria-hidden="true">🗺️</span>
        <p>No hay rutas para esta isla todavía. ¡Pronto añadiremos más!</p>
      </div>

      <!-- CTA comunidad -->
      <div class="rutas-cta section" data-reveal="up">
        <div class="rutas-cta__card card">
          <div class="rutas-cta__body">
            <span class="rutas-cta__emoji" aria-hidden="true">🚐</span>
            <div>
              <h3 class="rutas-cta__title">¿Conoces una ruta que no está aquí?</h3>
              <p class="rutas-cta__text">
                Los socios de El Burgao contribuyen con sus rutas favoritas.
                Comparte tu itinerario con la comunidad.
              </p>
            </div>
          </div>
          <a href="/contacto" class="btn btn--primary">Proponer una ruta</a>
        </div>
      </div>

    </div>
  </section>

</PageLayout>

<style>
/* ── FILTROS ─────────────────────────────────────────────────── */
.rutas-filters {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-10);
}

.filter-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-bg-raised);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  cursor: pointer;
  transition: all var(--duration-fast) var(--ease-out);
}

.filter-btn:hover {
  border-color: var(--color-brand);
  color: var(--color-brand);
  background: rgba(27,79,114,0.06);
}

.filter-btn.is-active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: white;
}

.filter-btn__count {
  font-size: var(--text-xs);
  background: rgba(255,255,255,0.2);
  border-radius: var(--radius-full);
  padding: 1px 6px;
  font-weight: var(--weight-bold);
  line-height: 1.6;
}
.filter-btn:not(.is-active) .filter-btn__count {
  background: var(--color-bg-alt);
  color: var(--color-text-subtle);
}

/* ── GRID ───────────────────────────────────────────────────── */
.rutas-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
  margin-bottom: var(--space-12);
}

/* Tarjeta oculta por filtro */
.ruta-card.is-hidden {
  display: none;
}

/* ── RUTA CARD ──────────────────────────────────────────────── */
.ruta-card {
  display: flex;
  flex-direction: column;
}

.ruta-card__img {
  height: 200px;
  background: var(--gradient-ocean);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* Textura sutil */
.ruta-card__img::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 40%, rgba(201,169,110,0.15) 0%, transparent 60%);
}

.ruta-card__emoji {
  font-size: 4.5rem;
  opacity: 0.45;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
  position: relative;
  z-index: 1;
}

.ruta-card__badges {
  position: absolute;
  top: var(--space-3);
  left: var(--space-3);
  right: var(--space-3);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.ruta-card__difficulty {
  font-size: var(--text-2xs);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: white;
  padding: 3px 10px;
  border-radius: var(--radius-full);
}

.ruta-card__featured {
  font-size: var(--text-2xs);
  font-weight: var(--weight-bold);
  background: var(--color-accent);
  color: var(--primitive-ocean-900);
  padding: 3px 10px;
  border-radius: var(--radius-full);
}

.ruta-card__body {
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  flex: 1;
}

.ruta-card__meta {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.ruta-card__isla {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: var(--color-brand);
  letter-spacing: var(--tracking-wide);
}

.ruta-card__title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  line-height: var(--leading-snug);
  color: var(--color-text);
  letter-spacing: var(--tracking-snug);
}

.ruta-card__excerpt {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ruta-card__details {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.ruta-card__detail {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--text-xs);
  font-weight: var(--weight-medium);
  color: var(--color-text-subtle);
}

.ruta-card__highlights {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding-top: var(--space-2);
  border-top: 1px solid var(--color-border);
}

.ruta-card__highlights li {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  padding-left: var(--space-3);
  position: relative;
}
.ruta-card__highlights li::before {
  content: '·';
  position: absolute;
  left: var(--space-1);
  color: var(--color-accent);
  font-weight: var(--weight-bold);
}

.ruta-card__more {
  font-weight: var(--weight-semibold);
  color: var(--color-brand) !important;
}

.ruta-card__cta {
  margin-top: auto;
  width: fit-content;
}

/* ── VACÍO ──────────────────────────────────────────────────── */
.rutas-empty {
  text-align: center;
  padding: var(--space-20);
  color: var(--color-text-subtle);
  font-size: var(--text-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
}
.rutas-empty span { font-size: 3rem; }

/* ── CTA CONTRIBUIR ─────────────────────────────────────────── */
.rutas-cta__card {
  padding: var(--space-8);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
  background: var(--color-bg-alt);
}

.rutas-cta__body {
  display: flex;
  align-items: center;
  gap: var(--space-5);
}

.rutas-cta__emoji { font-size: 3rem; flex-shrink: 0; }

.rutas-cta__title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: var(--color-text);
  margin-bottom: var(--space-1);
}

.rutas-cta__text {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  max-width: none;
}

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .rutas-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .rutas-grid { grid-template-columns: 1fr; }
  .rutas-cta__card { flex-direction: column; align-items: flex-start; }
}
</style>

<script>
/* Filtro de rutas por isla */
(function () {
  const btns  = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.ruta-card');
  const empty = document.getElementById('rutasEmpty');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      // Actualizar botones
      btns.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      // Filtrar tarjetas
      let visible = 0;
      cards.forEach(card => {
        const isla = card.dataset.isla;
        const show = filter === 'all' || isla === filter;
        card.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });

      // Mostrar estado vacío si no hay resultados
      if (empty) {
        empty.hidden = visible > 0;
      }
    });
  });
})();
</script>

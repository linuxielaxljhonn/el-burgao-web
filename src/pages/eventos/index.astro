---
/**
 * eventos/index.astro
 * ─────────────────────────────────────────────────────────────
 * Página de eventos con vista lista + vista calendario.
 */

import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allEventos = await getCollection('eventos', ({ data }) => !data.draft);
allEventos.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const now = new Date();
now.setHours(0, 0, 0, 0);

const proximos  = allEventos.filter(e => e.data.date >= now);
const pasados   = allEventos.filter(e => e.data.date < now).reverse();

const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
               'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const MESES_CORTO = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

function formatFecha(date: Date) {
  return date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
}

const typeColors: Record<string, string> = {
  'Concentración': '#1B4F72',
  'Ruta':          '#27AE60',
  'Reunión':       '#2471a3',
  'Asamblea':      '#8e44ad',
  'Manifestación': '#c0392b',
  'Formación':     '#e67e22',
  'Social':        '#C9A96E',
  'Otro':          '#7f8c8d',
};
---

<PageLayout
  title="Agenda"
  description="Agenda de la Asociación Autocaravanista El Burgao: encuentros, rutas, reuniones, asambleas y convocatorias en las Islas Canarias."
  heading="Eventos y concentraciones"
  subheading="Toda la agenda de El Burgao en un solo lugar. Concentraciones, rutas organizadas, talleres y asambleas."
  emoji="📅"
  eyebrow="📅 Agenda"
  breadcrumbs={[{ label: 'Eventos', href: '/eventos' }]}
>

  <section class="section">
    <div class="container">

      <!-- Toggle vista -->
      <div class="view-toggle" role="group" aria-label="Cambiar vista">
        <button class="view-btn is-active" data-view="list" aria-pressed="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
            <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
          Lista
        </button>
        <button class="view-btn" data-view="calendar" aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          Calendario
        </button>
      </div>

      <!-- ── VISTA LISTA ── -->
      <div id="viewList">

        {proximos.length > 0 ? (
          <>
            <h2 class="eventos-section-title">Próximos eventos</h2>
            <div class="eventos-list" role="list">
              {proximos.map((e, i) => (
                <article class="evento-full-card card" role="listitem"
                  data-reveal="up" data-delay={`${i * 80}`}>
                  <div class="evento-full-card__date-col">
                    <div class="evento-date-badge">
                      <span class="evento-date-badge__day">{e.data.date.getDate().toString().padStart(2,'0')}</span>
                      <span class="evento-date-badge__month">{MESES_CORTO[e.data.date.getMonth()]}</span>
                      <span class="evento-date-badge__year">{e.data.date.getFullYear()}</span>
                    </div>
                    {e.data.endDate && (
                      <div class="evento-end-date">
                        hasta {e.data.endDate.getDate()} {MESES_CORTO[e.data.endDate.getMonth()]}
                      </div>
                    )}
                  </div>

                  <div class="evento-full-card__body">
                    <div class="evento-full-card__meta">
                      <span
                        class="badge"
                        style={`background:${typeColors[e.data.type] ?? '#888'};color:white;`}
                      >{e.data.type}</span>
                      {e.data.membersOnly && <span class="badge badge--accent">Solo socios</span>}
                    </div>
                    <h3 class="evento-full-card__title">
                      <span aria-hidden="true">{e.data.emoji}</span> {e.data.title}
                    </h3>
                    <p class="evento-full-card__desc">{e.data.description}</p>
                    <div class="evento-full-card__location">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                      </svg>
                      {e.data.location}
                    </div>
                  </div>

                  <div class="evento-full-card__actions">
                    <a href={`/eventos/${e.slug}`} class="btn btn--secondary btn--sm">Ver detalles</a>
                    <a
                      href={`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(e.data.title)}&dates=${e.data.date.toISOString().replace(/[-:]/g,'').split('.')[0]}Z/${(e.data.endDate ?? e.data.date).toISOString().replace(/[-:]/g,'').split('.')[0]}Z&details=${encodeURIComponent(e.data.description)}&location=${encodeURIComponent(e.data.location)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn--ghost btn--sm"
                      aria-label={`Añadir ${e.data.title} a Google Calendar`}
                      title="Añadir a Google Calendar"
                    >
                      📅
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="eventos-empty-msg">
            <span>📅</span>
            <p>No hay eventos próximos programados. ¡Vuelve pronto!</p>
          </div>
        )}

        {pasados.length > 0 && (
          <details class="eventos-pasados">
            <summary class="eventos-pasados__toggle">
              Eventos pasados ({pasados.length})
            </summary>
            <div class="eventos-list" role="list" style="margin-top:var(--space-5);opacity:0.65;">
              {pasados.map(e => (
                <article class="evento-full-card card" role="listitem">
                  <div class="evento-full-card__date-col">
                    <div class="evento-date-badge evento-date-badge--past">
                      <span class="evento-date-badge__day">{e.data.date.getDate().toString().padStart(2,'0')}</span>
                      <span class="evento-date-badge__month">{MESES_CORTO[e.data.date.getMonth()]}</span>
                      <span class="evento-date-badge__year">{e.data.date.getFullYear()}</span>
                    </div>
                  </div>
                  <div class="evento-full-card__body">
                    <div class="evento-full-card__meta">
                      <span class="badge" style={`background:${typeColors[e.data.type] ?? '#888'};color:white;opacity:0.7`}>{e.data.type}</span>
                    </div>
                    <h3 class="evento-full-card__title">{e.data.emoji} {e.data.title}</h3>
                    <div class="evento-full-card__location">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                      </svg>
                      {e.data.location}
                    </div>
                  </div>
                  <div class="evento-full-card__actions">
                    <a href={`/eventos/${e.slug}`} class="btn btn--outline btn--sm">Ver detalles</a>
                  </div>
                </article>
              ))}
            </div>
          </details>
        )}
      </div>

      <!-- ── VISTA CALENDARIO ── -->
      <div id="viewCalendar" hidden>
        <div id="calendarWidget" class="calendar-widget"
          data-events={JSON.stringify(allEventos.map(e => ({
            title: e.data.title,
            date:  e.data.date.toISOString().split('T')[0],
            emoji: e.data.emoji,
            slug:  e.slug,
            type:  e.data.type,
          })))}
        ></div>
      </div>

    </div>
  </section>

</PageLayout>

<style>
/* ── TOGGLE VISTA ────────────────────────────────────────────── */
.view-toggle {
  display: flex;
  gap: var(--space-2);
  margin-bottom: var(--space-8);
}
.view-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-5);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-bg-raised);
  color: var(--color-text-muted);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  cursor: pointer;
  transition: all var(--duration-fast);
}
.view-btn.is-active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: white;
}

/* ── HEADING SECCIÓN ─────────────────────────────────────────── */
.eventos-section-title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  color: var(--color-text);
  margin-bottom: var(--space-6);
}

/* ── EVENTO CARD COMPLETA ────────────────────────────────────── */
.eventos-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-bottom: var(--space-10);
}

.evento-full-card {
  display: grid;
  grid-template-columns: 100px 1fr auto;
  align-items: center;
  gap: var(--space-6);
  padding: var(--space-5) var(--space-6);
  transition: box-shadow var(--duration-base), transform var(--duration-base) var(--ease-out);
}
.evento-full-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.evento-date-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  background: rgba(27,79,114,0.07);
  border: 1px solid rgba(27,79,114,0.15);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-2);
  flex-shrink: 0;
}
.evento-date-badge--past {
  background: var(--color-bg-alt);
  border-color: var(--color-border);
}

.evento-date-badge__day {
  font-family: var(--font-display);
  font-size: var(--text-3xl);
  font-weight: var(--weight-bold);
  color: var(--color-brand);
  line-height: 1;
}
.evento-date-badge--past .evento-date-badge__day { color: var(--color-text-subtle); }

.evento-date-badge__month {
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wider);
  color: var(--color-text-subtle);
}
.evento-date-badge__year {
  font-size: var(--text-2xs);
  color: var(--color-text-subtle);
}

.evento-end-date {
  font-size: var(--text-2xs);
  color: var(--color-text-subtle);
  text-align: center;
  margin-top: var(--space-1);
  font-style: italic;
}

.evento-full-card__body { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
.evento-full-card__meta { display: flex; gap: var(--space-2); flex-wrap: wrap; }
.evento-full-card__title {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: var(--color-text);
  line-height: var(--leading-snug);
}
.evento-full-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.evento-full-card__location {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  font-weight: var(--weight-medium);
  color: var(--color-text-subtle);
}
.evento-full-card__actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  flex-shrink: 0;
  align-items: flex-end;
}

/* ── PASADOS ─────────────────────────────────────────────────── */
.eventos-pasados {
  margin-top: var(--space-10);
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-6);
}
.eventos-pasados__toggle {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text-muted);
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.eventos-pasados__toggle::before {
  content: '▶';
  font-size: var(--text-xs);
  transition: transform var(--duration-fast);
}
.eventos-pasados[open] .eventos-pasados__toggle::before {
  transform: rotate(90deg);
}

/* ── VACÍO ──────────────────────────────────────────────────── */
.eventos-empty-msg {
  text-align: center;
  padding: var(--space-20);
  color: var(--color-text-subtle);
  font-size: var(--text-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
}
.eventos-empty-msg span { font-size: 3rem; }

/* ── CALENDARIO ──────────────────────────────────────────────── */
.calendar-widget {
  background: var(--color-bg-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  min-height: 500px;
}

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 768px) {
  .evento-full-card {
    grid-template-columns: 80px 1fr;
    grid-template-rows: auto auto;
    gap: var(--space-4);
    padding: var(--space-4);
  }
  .evento-full-card__actions {
    grid-column: 1 / -1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }
}
@media (max-width: 480px) {
  .evento-full-card__title { font-size: var(--text-lg); }
}
</style>

<script>
/* ── Toggle vista lista / calendario ─────────────────────────── */
(function () {
  const btns     = document.querySelectorAll<HTMLButtonElement>('.view-btn');
  const viewList = document.getElementById('viewList');
  const viewCal  = document.getElementById('viewCalendar');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => { b.classList.remove('is-active'); b.setAttribute('aria-pressed','false'); });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed','true');

      const view = btn.dataset.view;
      if (viewList) viewList.hidden = view !== 'list';
      if (viewCal)  viewCal.hidden  = view !== 'calendar';

      if (view === 'calendar') initCalendar();
    });
  });

  /* ── Mini calendario ────────────────────────────────────────── */
  let calInit = false;

  function initCalendar() {
    if (calInit) return;
    calInit = true;

    const container = document.getElementById('calendarWidget') as HTMLElement;
    if (!container) return;

    const rawEvents: {title:string;date:string;emoji:string;slug:string;type:string}[] =
      JSON.parse(container.dataset.events ?? '[]');

    const eventMap = new Map<string, typeof rawEvents[0][]>();
    rawEvents.forEach(e => {
      if (!eventMap.has(e.date)) eventMap.set(e.date, []);
      eventMap.get(e.date)!.push(e);
    });

    let currentDate = new Date();

    function render() {
      const year  = currentDate.getFullYear();
      const month = currentDate.getMonth();

      const MESES_LOCAL = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
                           'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
      const DIAS = ['L','M','X','J','V','S','D'];

      const firstDay = new Date(year, month, 1);
      const lastDay  = new Date(year, month + 1, 0);
      // Offset para que empiece en lunes
      let startDow = firstDay.getDay();
      startDow = startDow === 0 ? 6 : startDow - 1;

      let html = `
        <div class="cal-header">
          <button class="cal-nav" id="calPrev" aria-label="Mes anterior">←</button>
          <h3 class="cal-title">${MESES_LOCAL[month]} ${year}</h3>
          <button class="cal-nav" id="calNext" aria-label="Mes siguiente">→</button>
        </div>
        <div class="cal-grid">
          ${DIAS.map(d => `<div class="cal-dow">${d}</div>`).join('')}
          ${Array(startDow).fill('<div class="cal-cell cal-cell--empty"></div>').join('')}
      `;

      for (let d = 1; d <= lastDay.getDate(); d++) {
        const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const dayEvents = eventMap.get(dateStr) ?? [];
        const isToday = dateStr === new Date().toISOString().split('T')[0];

        html += `<div class="cal-cell${isToday ? ' cal-cell--today' : ''}${dayEvents.length ? ' cal-cell--has-event' : ''}">
          <span class="cal-day">${d}</span>
          ${dayEvents.slice(0,2).map(e =>
            `<a href="/eventos/${e.slug}" class="cal-event" title="${e.title}">${e.emoji} ${e.title.slice(0,16)}…</a>`
          ).join('')}
        </div>`;
      }

      html += '</div>';

      // Panel de eventos del mes
      const monthEvents = rawEvents.filter(e => e.date.startsWith(`${year}-${String(month+1).padStart(2,'0')}`));
      if (monthEvents.length > 0) {
        html += `<div class="cal-events-list">
          <h4 class="cal-events-list__title">Eventos de ${MESES_LOCAL[month]}</h4>
          ${monthEvents.map(e => `
            <a href="/eventos/${e.slug}" class="cal-event-item">
              <span>${e.emoji}</span>
              <div>
                <div class="cal-event-item__title">${e.title}</div>
                <div class="cal-event-item__date">${new Date(e.date + 'T12:00:00').toLocaleDateString('es-ES',{day:'numeric',month:'long'})}</div>
              </div>
            </a>
          `).join('')}
        </div>`;
      }

      container.innerHTML = html;

      document.getElementById('calPrev')?.addEventListener('click', () => {
        currentDate = new Date(year, month - 1, 1);
        render();
      });
      document.getElementById('calNext')?.addEventListener('click', () => {
        currentDate = new Date(year, month + 1, 1);
        render();
      });
    }

    render();

    // Estilos del calendario
    if (!document.getElementById('calStyles')) {
      const s = document.createElement('style');
      s.id = 'calStyles';
      s.textContent = `
        .cal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-6);}
        .cal-title{font-family:var(--font-display);font-size:var(--text-xl);font-weight:var(--weight-bold);color:var(--color-text);}
        .cal-nav{padding:var(--space-2) var(--space-4);border:1.5px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-bg-raised);color:var(--color-text-muted);cursor:pointer;font-size:var(--text-lg);transition:all var(--duration-fast);}
        .cal-nav:hover{border-color:var(--color-brand);color:var(--color-brand);}
        .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:var(--space-6);}
        .cal-dow{text-align:center;font-size:var(--text-xs);font-weight:var(--weight-bold);color:var(--color-text-subtle);padding:var(--space-2);letter-spacing:var(--tracking-wide);}
        .cal-cell{min-height:80px;border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:var(--space-2);background:var(--color-bg-raised);display:flex;flex-direction:column;gap:2px;}
        .cal-cell--empty{background:transparent;border-color:transparent;}
        .cal-cell--today{border-color:var(--color-brand);background:rgba(27,79,114,0.06);}
        .cal-cell--has-event{background:rgba(201,169,110,0.05);}
        .cal-day{font-size:var(--text-xs);font-weight:var(--weight-semibold);color:var(--color-text-muted);align-self:flex-end;}
        .cal-cell--today .cal-day{background:var(--color-brand);color:white;border-radius:var(--radius-full);width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:var(--text-2xs);}
        .cal-event{font-size:10px;background:rgba(27,79,114,0.1);border-radius:3px;padding:1px 4px;color:var(--color-brand);text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;}
        .cal-event:hover{background:var(--color-brand);color:white;}
        .cal-events-list{border-top:1px solid var(--color-border);padding-top:var(--space-5);}
        .cal-events-list__title{font-size:var(--text-sm);font-weight:var(--weight-bold);color:var(--color-text-subtle);text-transform:uppercase;letter-spacing:var(--tracking-widest);margin-bottom:var(--space-4);}
        .cal-event-item{display:flex;gap:var(--space-3);align-items:center;padding:var(--space-3);border-radius:var(--radius-md);text-decoration:none;transition:background var(--duration-fast);}
        .cal-event-item:hover{background:var(--color-bg-alt);}
        .cal-event-item span{font-size:1.4rem;flex-shrink:0;}
        .cal-event-item__title{font-size:var(--text-sm);font-weight:var(--weight-semibold);color:var(--color-text);}
        .cal-event-item__date{font-size:var(--text-xs);color:var(--color-text-subtle);}
        @media(max-width:640px){.cal-cell{min-height:50px;} .cal-event{display:none;} .cal-cell--has-event::after{content:'•';font-size:8px;color:var(--color-accent);align-self:center;}}
      `;
      document.head.appendChild(s);
    }
  }
})();
</script>

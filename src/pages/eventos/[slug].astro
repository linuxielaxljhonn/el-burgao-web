---
/**
 * /eventos/[slug].astro
 * ─────────────────────────────────────────────────────────────
 * Página de detalle de cada evento.
 * Generación estática desde Content Collections.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site.ts';

export async function getStaticPaths() {
  const eventos = await getCollection('eventos', ({ data }) => !data.draft);
  return eventos.map(e => ({ params: { slug: e.slug }, props: { evento: e } }));
}

const { evento } = Astro.props;
const { Content } = await evento.render();

const MESES = ['enero','febrero','marzo','abril','mayo','junio',
               'julio','agosto','septiembre','octubre','noviembre','diciembre'];

function formatFecha(d: Date) {
  return `${d.getDate()} de ${MESES[d.getMonth()]} de ${d.getFullYear()}`;
}

// Otros eventos próximos (excluye el actual)
const all = await getCollection('eventos', ({ data }) => !data.draft);
const now = new Date(); now.setHours(0,0,0,0);
const otros = all
  .filter(e => e.slug !== evento.slug && e.data.date >= now)
  .sort((a,b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

// Schema Event para SEO
const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": evento.data.title,
  "description": evento.data.description,
  "startDate": evento.data.date.toISOString(),
  ...(evento.data.endDate ? { "endDate": evento.data.endDate.toISOString() } : {}),
  "location": {
    "@type": "Place",
    "name": evento.data.location,
    "address": { "@type": "PostalAddress", "addressCountry": "ES", "addressRegion": "Canarias" }
  },
  "organizer": { "@type": "Organization", "name": siteConfig.name, "url": siteConfig.url },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
};

const isPast = evento.data.date < now;
---

<BaseLayout title={evento.data.title} description={evento.data.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

  <!-- Hero evento -->
  <div class="evento-hero">
    <div class="evento-hero__bg" aria-hidden="true"></div>
    <div class="container evento-hero__content">

      <nav class="breadcrumbs" aria-label="Ruta de navegación">
        <ol class="breadcrumbs__list">
          <li class="breadcrumbs__item"><a href="/" class="breadcrumbs__link">Inicio</a></li>
          <li class="breadcrumbs__item">
            <span class="breadcrumbs__sep" aria-hidden="true">/</span>
            <a href="/eventos" class="breadcrumbs__link">Eventos</a>
          </li>
          <li class="breadcrumbs__item">
            <span class="breadcrumbs__sep" aria-hidden="true">/</span>
            <span class="breadcrumbs__current" aria-current="page">{evento.data.title}</span>
          </li>
        </ol>
      </nav>

      <div class="evento-hero__tags">
        <span class="badge badge--dark">{evento.data.type}</span>
        {evento.data.membersOnly && <span class="badge badge--accent">Solo socios</span>}
        {isPast && <span class="badge" style="background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.7);">Evento pasado</span>}
      </div>

      <h1 class="evento-hero__title">
        <span aria-hidden="true">{evento.data.emoji}</span>
        {evento.data.title}
      </h1>

      <p class="evento-hero__desc">{evento.data.description}</p>

      <!-- Info rápida -->
      <div class="evento-hero__info">
        <div class="evento-info-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <time datetime={evento.data.date.toISOString()}>{formatFecha(evento.data.date)}{evento.data.time && ` · ${evento.data.time} h`}</time>
          {evento.data.endDate && (
            <> — <time datetime={evento.data.endDate.toISOString()}>{formatFecha(evento.data.endDate)}</time></>
          )}
        </div>
        <div class="evento-info-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          {evento.data.location}
        </div>
        {evento.data.price > 0 && (
          <div class="evento-info-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
            {evento.data.price}€ / persona
          </div>
        )}
        {evento.data.price === 0 && (
          <div class="evento-info-pill evento-info-pill--free">
            ✅ Entrada gratuita
          </div>
        )}
      </div>

    </div>
  </div>

  <!-- Cuerpo -->
  <div class="section">
    <div class="container">
      <div class="evento-layout">

        <!-- Contenido markdown -->
        <article class="evento-prose prose">
          {evento.data.image && (
            <figure class="evento-cartel">
              <img src={evento.data.image} alt={evento.data.imageAlt || `Cartel de ${evento.data.title}`} loading="lazy" decoding="async" />
            </figure>
          )}
          {evento.data.poster && (
            <p><a class="btn btn--outline btn--sm" href={evento.data.poster} target="_blank" rel="noopener">📄 Descargar documento (PDF)</a></p>
          )}
          <Content />
          {/* Fallback si no hay contenido largo */}
          {evento.data.description && (
            <p class="evento-prose__fallback">{evento.data.description}</p>
          )}
        </article>

        <!-- Sidebar -->
        <aside class="evento-sidebar">

          <!-- Acción principal -->
          <div class="sidebar-card sidebar-card--action">
            {!isPast ? (
              evento.data.membersOnly ? (
                <>
                  <p class="sidebar-card__note">Este evento es exclusivo para socios de El Burgao. La junta enviará los detalles a los socios.</p>
                  <a href="/hazte-socio" class="btn btn--primary btn--full">Hazte socio</a>
                </>
              ) : evento.data.registrationUrl ? (
                <>
                  <a href={evento.data.registrationUrl} target="_blank" rel="noopener" class="btn btn--primary btn--full">
                    Inscribirse al evento
                  </a>
                </>
              ) : (
                <>
                  <p class="sidebar-card__note">Para más información sobre inscripciones, contacta con la asociación.</p>
                  <a href="/contacto" class="btn btn--primary btn--full">Contactar</a>
                </>
              )
            ) : (
              <p class="sidebar-card__note" style="text-align:center;color:var(--color-text-subtle);">
                Este evento ya ha tenido lugar.
              </p>
            )}
          </div>

          <!-- Añadir al calendario -->
          {!isPast && (
            <div class="sidebar-card">
              <h3 class="sidebar-card__title">📅 Añadir al calendario</h3>
              <div class="cal-add-btns">
                <a
                  href={`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(evento.data.title)}&dates=${evento.data.date.toISOString().replace(/[-:]/g,'').split('.')[0]}Z/${(evento.data.endDate ?? evento.data.date).toISOString().replace(/[-:]/g,'').split('.')[0]}Z&details=${encodeURIComponent(evento.data.description)}&location=${encodeURIComponent(evento.data.location)}`}
                  target="_blank" rel="noopener noreferrer"
                  class="btn btn--outline btn--sm btn--full"
                >
                  📅 Google Calendar
                </a>
                <a
                  href={`data:text/calendar;charset=utf-8,BEGIN:VCALENDAR%0AVERSION:2.0%0APRODID:-//El%20Burgao//ES%0ABEGIN:VEVENT%0ADTSTART:${evento.data.date.toISOString().replace(/[-:]/g,'').split('.')[0]}Z%0ADTEND:${(evento.data.endDate ?? evento.data.date).toISOString().replace(/[-:]/g,'').split('.')[0]}Z%0ASUMMARY:${encodeURIComponent(evento.data.title)}%0ADESCRIPTION:${encodeURIComponent(evento.data.description)}%0ALOCATION:${encodeURIComponent(evento.data.location)}%0AEND:VEVENT%0AEND:VCALENDAR`}
                  download={`${evento.slug}.ics`}
                  class="btn btn--outline btn--sm btn--full"
                >
                  🍎 Apple Calendar (.ics)
                </a>
              </div>
            </div>
          )}

          <!-- Compartir -->
          <div class="sidebar-card">
            <h3 class="sidebar-card__title">📤 Compartir</h3>
            <div class="cal-add-btns">
              <a
                href={`https://wa.me/?text=${encodeURIComponent('🚐 ' + evento.data.title + ' — ' + siteConfig.url + '/eventos/' + evento.slug)}`}
                target="_blank" rel="noopener noreferrer"
                class="btn btn--secondary btn--sm btn--full"
              >
                💬 WhatsApp
              </a>
              <button class="btn btn--outline btn--sm btn--full" id="copyEventLink"
                data-url={`${siteConfig.url}/eventos/${evento.slug}`}>
                🔗 Copiar enlace
              </button>
            </div>
          </div>

        </aside>
      </div>

      <!-- Otros eventos -->
      {otros.length > 0 && (
        <div class="otros-eventos" data-reveal="up">
          <h2 class="otros-eventos__title">Más eventos próximos</h2>
          <div class="otros-eventos__grid">
            {otros.map(e => (
              <a href={`/eventos/${e.slug}`} class="otro-evento card card--hoverable">
                <div class="otro-evento__emoji" aria-hidden="true">{e.data.emoji}</div>
                <div class="otro-evento__body">
                  <time class="otro-evento__date">
                    {e.data.date.getDate()} {['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][e.data.date.getMonth()]}
                  </time>
                  <div class="otro-evento__title">{e.data.title}</div>
                  <div class="otro-evento__loc">{e.data.location}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <nav class="ruta-nav">
        <a href="/eventos" class="btn btn--outline">← Volver a eventos</a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
.evento-cartel { margin: 0 0 var(--space-6); }
.evento-cartel img { width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }

.evento-hero {
  position: relative;
  padding-top: calc(var(--header-h) + var(--space-12));
  padding-bottom: var(--space-16);
  background: var(--primitive-ocean-900);
  overflow: hidden;
}
.evento-hero__bg {
  position: absolute; inset: 0;
  background: var(--gradient-hero); opacity: 0.85;
}
.evento-hero__bg::after {
  content:''; position:absolute; inset:0;
  background-image: radial-gradient(rgba(201,169,110,0.07) 1px, transparent 1px);
  background-size: 28px 28px;
}
.evento-hero__content { position: relative; z-index: 1; }

.evento-hero__tags { display:flex; gap:var(--space-2); flex-wrap:wrap; margin-bottom:var(--space-5); }

.evento-hero__title {
  font-family: var(--font-display);
  font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
  font-weight: var(--weight-black);
  color: white; line-height: var(--leading-snug);
  letter-spacing: var(--tracking-snug);
  margin-bottom: var(--space-4);
}
.evento-hero__desc {
  font-size: clamp(var(--text-base), 2vw, var(--text-lg));
  color: rgba(255,255,255,0.7);
  line-height: var(--leading-relaxed);
  max-width: 60ch;
  margin-bottom: var(--space-6);
}

.evento-hero__info { display:flex; gap:var(--space-3); flex-wrap:wrap; }

.evento-info-pill {
  display: inline-flex; align-items: center; gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-full);
  font-size: var(--text-sm); font-weight: var(--weight-medium);
  color: rgba(255,255,255,0.8);
}
.evento-info-pill--free { background:rgba(39,174,96,0.15); border-color:rgba(39,174,96,0.25); color:#52be80; }

/* Layout */
.evento-layout { display:grid; grid-template-columns:1fr 320px; gap:var(--space-12); align-items:start; }

.evento-prose { max-width: 68ch; }
.evento-prose__fallback { display:none; }
.evento-prose:empty + .evento-prose__fallback, .evento-prose p:only-child .evento-prose__fallback { display:block; }

/* Sidebar */
.evento-sidebar { display:flex; flex-direction:column; gap:var(--space-4); position:sticky; top:calc(var(--header-h) + var(--space-6)); }

.sidebar-card {
  background: var(--color-bg-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
}
.sidebar-card--action { padding: var(--space-5); display:flex; flex-direction:column; gap:var(--space-3); }
.sidebar-card__title { font-size:var(--text-xs); font-weight:var(--weight-bold); color:var(--color-text); letter-spacing:var(--tracking-widest); text-transform:uppercase; margin-bottom:var(--space-4); }
.sidebar-card__note { font-size:var(--text-sm); color:var(--color-text-muted); line-height:var(--leading-normal); }
.cal-add-btns { display:flex; flex-direction:column; gap:var(--space-3); }

/* Otros eventos */
.otros-eventos { margin-top: var(--space-16); padding-top: var(--space-10); border-top:1px solid var(--color-border); }
.otros-eventos__title { font-family:var(--font-display); font-size:var(--text-2xl); font-weight:var(--weight-bold); color:var(--color-text); margin-bottom:var(--space-6); }
.otros-eventos__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--space-4); }

.otro-evento { display:flex; gap:var(--space-4); padding:var(--space-4); text-decoration:none; }
.otro-evento__emoji { font-size:2rem; flex-shrink:0; }
.otro-evento__body { display:flex; flex-direction:column; gap:var(--space-1); }
.otro-evento__date { font-size:var(--text-xs); font-weight:var(--weight-bold); color:var(--color-brand); text-transform:uppercase; letter-spacing:var(--tracking-wider); }
.otro-evento__title { font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-text); line-height:var(--leading-snug); }
.otro-evento__loc { font-size:var(--text-xs); color:var(--color-text-subtle); }

.ruta-nav { padding-top:var(--space-10); margin-top:var(--space-10); border-top:1px solid var(--color-border); }

/* Breadcrumbs */
.breadcrumbs { margin-bottom: var(--space-8); }
.breadcrumbs__list { display:flex; align-items:center; flex-wrap:wrap; gap:var(--space-1); list-style:none; }
.breadcrumbs__item { display:flex; align-items:center; gap:var(--space-1); }
.breadcrumbs__link { font-size:var(--text-xs); font-weight:var(--weight-medium); color:rgba(255,255,255,0.5); text-decoration:none; transition:color var(--duration-fast); }
.breadcrumbs__link:hover { color:var(--color-accent); }
.breadcrumbs__sep { font-size:var(--text-xs); color:rgba(255,255,255,0.25); }
.breadcrumbs__current { font-size:var(--text-xs); font-weight:var(--weight-semibold); color:var(--color-accent); }

@media (max-width:1024px) {
  .evento-layout { grid-template-columns:1fr; }
  .evento-sidebar { position:static; display:grid; grid-template-columns:repeat(2,1fr); }
  .otros-eventos__grid { grid-template-columns:repeat(2,1fr); }
}
@media (max-width:640px) {
  .evento-sidebar { grid-template-columns:1fr; }
  .otros-eventos__grid { grid-template-columns:1fr; }
}
</style>

<script>
document.getElementById('copyEventLink')?.addEventListener('click', async (e) => {
  const btn = e.currentTarget as HTMLButtonElement;
  const url = btn.dataset.url ?? window.location.href;
  try {
    await navigator.clipboard.writeText(url);
    btn.textContent = '✅ ¡Copiado!';
    setTimeout(() => { btn.textContent = '🔗 Copiar enlace'; }, 2000);
  } catch { btn.textContent = '❌ Error'; }
});
</script>

---
/**
 * contacto.astro
 * ─────────────────────────────────────────────────────────────
 * Página de contacto con formulario accesible + datos de contacto.
 * Web3Forms para el envío (sin servidor).
 */

import PageLayout from '../layouts/PageLayout.astro';
import siteConfig, { isPendiente } from '../config/site.ts';

const { contact, name, cuota, legal } = siteConfig;
const social = siteConfig.social.filter(s => s.url);

const motivosContacto = [
  { value: '',            label: 'Selecciona el motivo' },
  { value: 'informacion', label: 'Solicitar información sobre la asociación' },
  { value: 'socio',       label: 'Quiero hacerme socio' },
  { value: 'evento',      label: 'Información sobre un evento' },
  { value: 'ruta',        label: 'Proponer una ruta, parada o pernocta' },
  { value: 'senal',       label: 'Denunciar una señal o prohibición abusiva' },
  { value: 'incidencia',  label: 'Reportar una incidencia' },
  { value: 'prensa',      label: 'Prensa / medios de comunicación' },
  { value: 'otro',        label: 'Otro motivo' },
];
---

<PageLayout
  title="Contacto"
  description="Contacta con la Asociación Autocaravanista El Burgao: dudas, propuestas de rutas y pernoctas, denuncias de señalización o solicitudes de información."
  heading="Hablemos"
  subheading="Escríbenos con tus dudas, propuestas de rutas o avisos de señalización. La junta responde lo antes posible."
  emoji="📬"
  eyebrow="📬 Contacto"
  breadcrumbs={[{ label: 'Contacto', href: '/contacto' }]}
>

  <section class="section">
    <div class="container">
      <div class="contacto-layout">

        <!-- ── INFO DE CONTACTO ── -->
        <div class="contacto-info" data-reveal="left">

          <div class="contact-cards">

            <!-- Email -->
            <a href={isPendiente(contact.email) ? '#contactoForm' : `mailto:${contact.email}`} class="contact-card">
              <div class="contact-card__icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="contact-card__body">
                <span class="contact-card__label">Correo electrónico</span>
                <span class="contact-card__value">{contact.email}</span>
                <span class="contact-card__note">O usa el formulario</span>
              </div>
            </a>

            <!-- WhatsApp -->
            {contact.whatsapp && <a href={`https://wa.me/${contact.whatsapp.replace(/\D/g,'')}`} target="_blank" rel="noopener noreferrer" class="contact-card">
              <div class="contact-card__icon contact-card__icon--green" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                </svg>
              </div>
              <div class="contact-card__body">
                <span class="contact-card__label">WhatsApp</span>
                <span class="contact-card__value">+{contact.whatsapp}</span>
              </div>
            </a>}

            <!-- Ubicación -->
            <div class="contact-card contact-card--static">
              <div class="contact-card__icon contact-card__icon--ocean" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div class="contact-card__body">
                <span class="contact-card__label">Ubicación</span>
                <span class="contact-card__value">{contact.location}</span>
                <span class="contact-card__note">Asociación sin sede física fija</span>
              </div>
            </div>

          </div>

          <!-- Redes sociales -->
          {social.length > 0 && <div class="contacto-social">
            <p class="contacto-social__title">También puedes encontrarnos en</p>
            <div class="contacto-social__links">
              {social.map(s => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contacto-social__link"
                  aria-label={s.name}
                >
                  {s.name === 'Facebook' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                    </svg>
                  )}
                  {s.name === 'Instagram' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="2" width="20" height="20" rx="5"/>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                    </svg>
                  )}
                  {s.name === 'WhatsApp' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                    </svg>
                  )}
                  <span>{s.name}</span>
                </a>
              ))}
            </div>
          </div>}

          <!-- FAQ rápido -->
          <div class="contacto-faq">
            <h3 class="contacto-faq__title">Preguntas frecuentes</h3>
            {[
              { q: '¿Cuánto cuesta hacerse socio?', a: `${cuota.alta} € el primer año y ${cuota.renovacion} € las renovaciones.` },
              { q: '¿Cómo me hago socio?', a: 'Rellena la solicitud en la página Hazte socio; la junta te enviará los datos de pago y tu carnet.' },
              { q: '¿Puedo participar en eventos antes de ser socio?', a: 'Algunos eventos son abiertos. Los exclusivos para socios se indican claramente.' },
            ].map(faq => (
              <details class="faq-item">
                <summary class="faq-item__q">{faq.q}</summary>
                <p class="faq-item__a">{faq.a}</p>
              </details>
            ))}
          </div>

        </div>

        <!-- ── FORMULARIO ── -->
        <div class="contacto-form-wrap card" data-reveal="right">
          <h2 class="contacto-form-title">Envíanos un mensaje</h2>

          <form
            class="contacto-form"
            id="contactoForm"
            novalidate
            name="contacto"
            method="POST"
            action={siteConfig.formularios.endpoint}
          >
            <input type="hidden" name="access_key" value={siteConfig.formularios.clave} />
            <input type="hidden" name="subject" value="Mensaje de contacto — web El Burgao" />
            <input type="hidden" name="from_name" value="Web El Burgao" />
            <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="c-nombre">
                  Nombre <span class="required" aria-hidden="true">*</span>
                </label>
                <input type="text" id="c-nombre" name="nombre" class="form-input"
                  placeholder="Tu nombre" required autocomplete="given-name" />
                <span class="form-error" id="c-nombre-error" role="alert"></span>
              </div>
              <div class="form-group">
                <label class="form-label" for="c-email">
                  Email <span class="required" aria-hidden="true">*</span>
                </label>
                <input type="email" id="c-email" name="email" class="form-input"
                  placeholder="tu@correo.com" required autocomplete="email" />
                <span class="form-error" id="c-email-error" role="alert"></span>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="c-motivo">Motivo del contacto</label>
              <select id="c-motivo" name="motivo" class="form-input form-select">
                {motivosContacto.map(m => (
                  <option value={m.value}>{m.label}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="c-mensaje">
                Mensaje <span class="required" aria-hidden="true">*</span>
              </label>
              <textarea id="c-mensaje" name="mensaje" class="form-input form-textarea"
                placeholder="Escribe tu mensaje aquí..." rows="5" required></textarea>
              <span class="form-error" id="c-mensaje-error" role="alert"></span>
              <span class="form-hint" id="charCount">0 / 1000 caracteres</span>
            </div>

            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" name="rgpd" required />
                <span>
                  Acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>
                  y el tratamiento de mis datos para responder a esta consulta.
                  <span class="required" aria-hidden="true">*</span>
                </span>
              </label>
              <span class="form-error" id="c-rgpd-error" role="alert"></span>
              <p class="form-legal">Responsable: {legal.razonSocial}. Finalidad: responder a tu consulta. No se ceden datos a terceros.</p>
            </div>
            <p class="form-send-error" id="contactoError" hidden role="alert">No se ha podido enviar el mensaje. Revisa tu conexión e inténtalo de nuevo.</p>

            <button type="submit" class="btn btn--primary btn--full" id="contactoSubmit">
              <span class="btn__text">Enviar mensaje</span>
              <span class="btn__loader" aria-hidden="true"></span>
            </button>
          </form>

          <!-- Éxito -->
          <div class="form-success" id="contactoSuccess" hidden aria-live="polite">
            <span aria-hidden="true">✉️</span>
            <h3>¡Mensaje enviado!</h3>
            <p>La junta te responderá lo antes posible. ¡Gracias por contactar con El Burgao!</p>
          </div>

        </div>
      </div>
    </div>
  </section>

</PageLayout>

<style>
.form-legal { font-size: .72rem; line-height: 1.45; color: var(--color-text-muted); margin-top: var(--space-2); }
.form-send-error { padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); background: rgba(220,53,69,.1); color: #b02a37; font-size: .875rem; }

.contacto-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
  align-items: start;
}

/* ── INFO ────────────────────────────────────────────────────── */
.contacto-info { display:flex; flex-direction:column; gap:var(--space-8); }

.contact-cards { display:flex; flex-direction:column; gap:var(--space-4); }

.contact-card {
  display: flex; align-items: flex-start; gap: var(--space-4);
  padding: var(--space-5);
  background: var(--color-bg-raised);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: all var(--duration-fast) var(--ease-out);
  box-shadow: var(--shadow-xs);
}
.contact-card:not(.contact-card--static):hover {
  border-color: var(--color-brand);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.contact-card__icon {
  width: 46px; height: 46px;
  background: rgba(27,79,114,0.1);
  border: 1px solid rgba(27,79,114,0.15);
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-brand);
  flex-shrink: 0;
}
.contact-card__icon--green { background:rgba(39,174,96,0.1); border-color:rgba(39,174,96,0.15); color:#27AE60; }
.contact-card__icon--ocean { background:rgba(27,79,114,0.1); border-color:rgba(27,79,114,0.15); color:var(--color-brand); }

.contact-card__body { display:flex; flex-direction:column; gap:var(--space-1); }
.contact-card__label { font-size:var(--text-xs); font-weight:var(--weight-semibold); text-transform:uppercase; letter-spacing:var(--tracking-wider); color:var(--color-text-subtle); }
.contact-card__value { font-size:var(--text-base); font-weight:var(--weight-semibold); color:var(--color-text); }
.contact-card__note { font-size:var(--text-xs); color:var(--color-text-subtle); }

/* Social */
.contacto-social__title { font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-text-muted); margin-bottom:var(--space-4); }
.contacto-social__links { display:flex; gap:var(--space-3); flex-wrap:wrap; }
.contacto-social__link {
  display: inline-flex; align-items: center; gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  background: var(--color-bg-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--text-sm); font-weight: var(--weight-medium);
  color: var(--color-text-muted);
  text-decoration: none;
  transition: all var(--duration-fast);
}
.contacto-social__link:hover { border-color:var(--color-brand); color:var(--color-brand); background:rgba(27,79,114,0.06); }

/* FAQ */
.contacto-faq__title { font-family:var(--font-display); font-size:var(--text-xl); font-weight:var(--weight-bold); color:var(--color-text); margin-bottom:var(--space-4); }

.faq-item {
  border-bottom: 1px solid var(--color-border);
  padding-block: var(--space-4);
}
.faq-item:last-child { border-bottom: none; }

.faq-item__q {
  font-size: var(--text-sm); font-weight: var(--weight-semibold);
  color: var(--color-text); cursor: pointer;
  list-style: none;
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
}
.faq-item__q::after { content:'＋'; color:var(--color-brand); font-size:var(--text-lg); flex-shrink:0; }
.faq-item[open] .faq-item__q::after { content:'－'; }
.faq-item__a { font-size:var(--text-sm); color:var(--color-text-muted); line-height:var(--leading-relaxed); margin-top:var(--space-3); max-width:none; }

/* ── FORMULARIO ──────────────────────────────────────────────── */
.contacto-form-wrap { padding: var(--space-8); }

.contacto-form-title { font-family:var(--font-display); font-size:var(--text-2xl); font-weight:var(--weight-bold); color:var(--color-text); margin-bottom:var(--space-6); }

.contacto-form { display:flex; flex-direction:column; gap:var(--space-5); }

.form-success {
  text-align:center; padding:var(--space-12);
  display:flex; flex-direction:column; align-items:center; gap:var(--space-4);
}
.form-success span:first-child { font-size:3.5rem; }
.form-success h3 { font-family:var(--font-display); font-size:var(--text-2xl); font-weight:var(--weight-bold); color:var(--color-text); }
.form-success p { color:var(--color-text-muted); max-width:none; }

/* ── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width:1024px) { .contacto-layout { grid-template-columns:1fr; } }
@media (max-width:640px)  { .contacto-form-wrap { padding:var(--space-5); } }
</style>

<script>
(function () {
  const form      = document.getElementById('contactoForm') as HTMLFormElement;
  const success   = document.getElementById('contactoSuccess') as HTMLElement;
  const submitBtn = document.getElementById('contactoSubmit') as HTMLButtonElement;
  const textarea  = document.getElementById('c-mensaje') as HTMLTextAreaElement;
  const counter   = document.getElementById('charCount') as HTMLElement;
  if (!form) return;

  // Contador de caracteres
  textarea?.addEventListener('input', () => {
    const len = textarea.value.length;
    counter.textContent = `${len} / 1000 caracteres`;
    if (len > 900) counter.style.color = 'var(--color-error)';
    else counter.style.color = '';
    if (len > 1000) textarea.value = textarea.value.slice(0, 1000);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Limpiar errores
    ['c-nombre-error','c-email-error','c-mensaje-error','c-rgpd-error'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = '';
    });
    form.querySelectorAll('.form-input').forEach(el => el.classList.remove('is-error'));

    let valid = true;

    const nombre  = form.querySelector<HTMLInputElement>('#c-nombre');
    const email   = form.querySelector<HTMLInputElement>('#c-email');
    const mensaje = form.querySelector<HTMLTextAreaElement>('#c-mensaje');
    const rgpd    = form.querySelector<HTMLInputElement>('[name="rgpd"]');

    if (!nombre?.value.trim()) {
      document.getElementById('c-nombre-error')!.textContent = 'El nombre es obligatorio';
      nombre?.classList.add('is-error'); valid = false;
    }
    if (!email?.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      document.getElementById('c-email-error')!.textContent = 'Introduce un email válido';
      email?.classList.add('is-error'); valid = false;
    }
    if (!mensaje?.value.trim() || mensaje.value.trim().length < 10) {
      document.getElementById('c-mensaje-error')!.textContent = 'El mensaje debe tener al menos 10 caracteres';
      mensaje?.classList.add('is-error'); valid = false;
    }
    if (!rgpd?.checked) {
      document.getElementById('c-rgpd-error')!.textContent = 'Debes aceptar la política de privacidad';
      valid = false;
    }

    if (!valid) {
      form.querySelector('.is-error')?.scrollIntoView({ behavior:'smooth', block:'center' });
      return;
    }

    submitBtn.classList.add('is-loading');
    submitBtn.disabled = true;

    try {
      const data = new FormData(form);
      const res  = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json().catch(() => ({}));

      if (res.ok && json.success) {
        form.hidden = true;
        success.removeAttribute('hidden');
        success.scrollIntoView({ behavior:'smooth', block:'center' });
      } else {
        throw new Error();
      }
    } catch {
      document.getElementById('contactoError')?.removeAttribute('hidden');
    } finally {
      submitBtn.classList.remove('is-loading');
      submitBtn.disabled = false;
    }
  });
})();
</script>

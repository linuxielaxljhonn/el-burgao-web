# _headers — Netlify
# Cabeceras de seguridad y rendimiento para El Burgao
# ─────────────────────────────────────────────────────────────

# ── Todas las páginas ────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ── Admin — noindex adicional ────────────────────────────────
/admin
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow

# ── Service Worker — nunca cachear ──────────────────────────
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0

# ── Assets Astro (hash en nombre = cache inmutable) ──────────
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# ── Assets estáticos ─────────────────────────────────────────
/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000

# ── Manifest PWA ─────────────────────────────────────────────
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

# ── Sitemap y robots ─────────────────────────────────────────
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=86400

# ── Search index ─────────────────────────────────────────────
/search-index.json
  Cache-Control: public, max-age=3600
